# =============================================================================
# Vincent Kinney Portfolio — Environment Variables
# =============================================================================
# All variables are optional. Leave commented out for standard Vercel/local
# production builds. Copy to `.env.local` if you want local overrides.

# -----------------------------------------------------------------------------
# Build & Deployment Mode
# -----------------------------------------------------------------------------
# Set to "true" to generate a static export in `out/` configured for GitHub
# Pages at `/website-vincent-kinney` (used automatically by `npm run build:pages`).
# GITHUB_PAGES=true

# Set to "true" to generate a root-path static export in `out/` for static
# hosts such as Netlify or Cloudflare Pages (used by `npm run build:static`).
# NEXT_OUTPUT_EXPORT=true

# Override the canonical site URL used in Open Graph metadata, canonical tags,
# robots.txt, and sitemap.xml. Must include http:// or https://.
# Defaults to:
#   - https://vpkdevs.github.io/website-vincent-kinney/ when GITHUB_PAGES=true
#   - https://$VERCEL_PROJECT_PRODUCTION_URL (or $VERCEL_URL) on Vercel
#   - https://vincentkinney.dev otherwise
# NEXT_PUBLIC_SITE_URL=https://vincentkinney.dev

# Override the Next.js basePath/assetPrefix when building a subpath static export.
# Defaults to `/website-vincent-kinney` when GITHUB_PAGES=true, or empty otherwise.
# NEXT_PUBLIC_BASE_PATH=/website-vincent-kinney

# Set to "true" to force `next build --webpack` (enabled automatically on
# platforms without native Turbopack bindings such as android/arm64).
# NEXT_USE_WEBPACK=false

# -----------------------------------------------------------------------------
# Local Maintenance Scripts (optional — NOT needed for Vercel/CI builds)
# -----------------------------------------------------------------------------
# Path to Vincent's master PROJECTS.md registry used by `npm run generate:atlas`.
# Defaults to `../PROJECTS.md`.
# PROJECTS_REGISTRY=/path/to/PROJECTS.md

# URL footer text rendered on the Open Graph image by `npm run generate:og`.
# Defaults to `vpkdevs.github.io/website-vincent-kinney`.
# OG_DISPLAY_URL=vpkdevs.github.io/website-vincent-kinney
